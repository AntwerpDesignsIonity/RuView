  Quick-start commands:

  # 1. Activate Python venv
  source /home/antwerp/Creations/.2026/.Naked/RuView/.venv/bin/activate

  # 2. Run CSI bridge (ESP32 → Cognitum Seed)
  python scripts/seed_csi_bridge.py \
    --seed-url https://169.254.42.1:8443 \
    --token "$SEED_TOKEN" --udp-port 5006

  # 3. Run JS spatial pipelines
  node scripts/snn-csi-processor.js
  node scripts/mincut-person-counter.js

  # 4. Build & run Rust sensing server
  cd rust-port/wifi-densepose-rs
  cargo build -p wifi-densepose-sensing-server --release --no-default-features
  ./target/release/sensing-server

  # 5. Launch full Ionity stack
  ./.ionity/ionity.sh run

